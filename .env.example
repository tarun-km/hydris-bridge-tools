# Local/dev stand-in for the managed secret store (NFR-4 AC-3).
# In a real deployment these resolve from the managed secret store, never from files in the image.

# HMAC signing key Lite uses to verify the Pulse service-principal token.
LITE_MCP_SERVICE_TOKEN_SECRET=dev-only-service-secret-change-me

# HMAC signing key Lite uses to verify the per-call user-context token.
LITE_MCP_USER_CONTEXT_SECRET=dev-only-user-context-secret-change-me

# Where the fail-closed audit sink appends JSONL records.
LITE_MCP_AUDIT_LOG_PATH=./audit.jsonl

LITE_MCP_HOST=0.0.0.0
LITE_MCP_PORT=8765

# --- LLM connection seam (examples/run_diagnostic_session.py only) ---
# Not read by the MCP server itself - the bridge has no model-provider
# dependency (EXT-4/PD-13). Only the generic-MCP-client demo agent reads
# this, to prove tools 1-8 are usable end to end by a reasoning model.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Which Claude model the demo agent uses. See diagnostic_mcp/providers/anthropic/provider.py.
PULSE_LLM_MODEL=claude-sonnet-5
